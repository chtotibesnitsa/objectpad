{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web-handlesend && bun install --frozen-lockfile",
  "buildCommand": "cd web-handlesend && bun run build",
  "outputDirectory": "web-handlesend/dist",
  "rewrites": [
    { "source": "/((?!api(?:/|$)|assets/|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), accelerometer=(self), gyroscope=(self)" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
